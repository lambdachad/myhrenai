{
    "name": "myhrenai",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "wrangler types --check && vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "prepare": "svelte-kit sync || echo ''",
        "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "gen": "wrangler types"
    },
    "dependencies": {
        "resend": "^6.12.3"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/inter-tight": "^5.2.7",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.57.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.6",
        "typescript": "^6.0.2",
        "unplugin-fonts": "^2.0.0",
        "vite": "^8.0.7",
        "wrangler": "^4.81.0"
    }
}
